{
  "name": "novacode-studio",
  "productName": "NovaCode Studio",
  "version": "1.3.0",
  "novaGithubClientId": "Ov23libmIBCtfaaE8qON",
  "description": "Profesyonel Masaüstü ve Web Destekli Kod Editörü",
  "license": "MIT",
  "author": {
    "name": "Oray Yılmaz",
    "email": "orayyilmaz16@gmail.com"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --publish never",
    "sync:server": "node server/sync-server.mjs",
    "test": "node scripts/tests/git.test.cjs && node scripts/tests/sync.test.cjs && node scripts/tests/term.test.cjs && node scripts/tests/textbuffer.test.cjs && node scripts/tests/debug.test.cjs && node scripts/tests/pty.test.cjs && node scripts/tests/lsp.test.cjs && node scripts/tests/ai-tools.test.cjs && node scripts/tests/ai-complete.test.cjs",
    "brain": "node scripts/brain.mjs",
    "brain:check": "node scripts/brain.mjs --check",
    "version:check": "node scripts/check-version.mjs",
    "sync": "node scripts/auto-commit.mjs",
    "icons:gen": "node scripts/gen-file-icons.mjs"
  },
  "build": {
    "appId": "com.orayyilmaz.novacode",
    "productName": "NovaCode Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "electron-github.cjs",
      "electron-git.cjs",
      "electron-secrets.cjs",
      "electron-ai.cjs",
      "electron-search.cjs",
      "electron-ext.cjs",
      "electron-llm.cjs",
      "electron-update.cjs",
      "electron-term.cjs",
      "electron-debug.cjs",
      "electron-pty.cjs",
      "electron-lsp.cjs",
      "electron-textbuffer.cjs",
      "package.json",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaCode Studio",
      "runAfterFinish": true,
      "artifactName": "NovaCode-Studio-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*",
      "node_modules/@lydell/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "orayyilmaz16",
        "repo": "NovaCode-Studio"
      }
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrent": "^0.3.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "6.8.11",
    "lib0": "0.2.119",
    "lucide-react": "^1.71.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.57.0",
    "node-llama-cpp": "3.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "ws": "8.22.1",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "minimatch@^9": "11.0.1",
    "minimatch@^10": "11.0.1"
  }
}
