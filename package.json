{
  "name": "novacode-studio",
  "productName": "NovaCode Studio",
  "version": "1.1.0",
  "description": "Profesyonel Masaüstü ve Web Destekli Kod Editörü",
  "license": "MIT",
  "author": {
    "name": "Oray Yılmaz",
    "email": "orayyilmaz16@gmail.com"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "sync:server": "node server/sync-server.mjs"
  },
  "build": {
    "appId": "com.orayyilmaz.novacode",
    "productName": "NovaCode Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaCode Studio",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrent": "^0.3.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.17",
    "electron-is-dev": "^3.0.1",
    "lib0": "0.2.119",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "ws": "8.22.1",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
