{
  "name": "novacode-studio",
  "productName": "NovaCode Studio",
  "version": "1.10.2",
  "novaGithubClientId": "Ov23libmIBCtfaaE8qON",
  "description": "Profesyonel Masaüstü ve Web Destekli Kod Editörü",
  "license": "MIT",
  "author": {
    "name": "Oray Yılmaz",
    "email": "orayyilmaz16@gmail.com"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --publish never",
    "electron:build:mac": "vite build && electron-builder --mac --publish never",
    "electron:build:linux": "vite build && electron-builder --linux --publish never",
    "sync:server": "node server/sync-server.mjs",
    "analytics:server": "node server/analytics-server.mjs",
    "analytics:report": "node scripts/analytics-report.mjs",
    "test": "node scripts/tests/git.test.cjs && node scripts/tests/sync.test.cjs && node scripts/tests/term.test.cjs && node scripts/tests/textbuffer.test.cjs && node scripts/tests/debug.test.cjs && node scripts/tests/pty.test.cjs && node scripts/tests/lsp.test.cjs && node scripts/tests/ai-tools.test.cjs && node scripts/tests/ai-complete.test.cjs && node scripts/tests/completion-schedule.test.cjs && node scripts/tests/completion-shape.test.cjs && node scripts/tests/settings-migrate.test.cjs && node scripts/tests/palettes.test.cjs && node scripts/tests/release.test.cjs && node scripts/tests/paths.test.cjs && node scripts/tests/ai-security.test.cjs && node scripts/tests/syncserver.test.cjs && node scripts/tests/services.test.cjs && node scripts/tests/settings-selectors.test.cjs && node scripts/tests/i18n.test.cjs && node scripts/tests/electron-misc.test.cjs && node scripts/tests/replace.test.cjs && node scripts/tests/trust.test.cjs && node scripts/tests/preview-csp.test.cjs && node scripts/tests/history.test.cjs && node scripts/tests/snippets.test.cjs && node scripts/tests/keybindings.test.cjs && node scripts/tests/search-redos.test.cjs && node scripts/tests/ssh.test.cjs && node scripts/tests/ssh-sftp.test.cjs && node scripts/tests/deps.test.cjs && node scripts/tests/analytics.test.cjs && node scripts/tests/autocommit.test.cjs && node scripts/tests/autopilot.test.cjs && node scripts/tests/autofix.test.cjs && node scripts/tests/fs-handlers.test.cjs && node scripts/tests/secrets.test.cjs && node scripts/tests/ipc-contract.test.cjs && node scripts/tests/update.test.cjs && node scripts/tests/github.test.cjs && node scripts/tests/preload.test.cjs",
    "brain": "node scripts/brain.mjs",
    "brain:check": "node scripts/brain.mjs --check",
    "audit": "node scripts/audit-scan.mjs",
    "audit:check": "node scripts/audit-scan.mjs --check",
    "health": "node scripts/health-monitor.mjs",
    "version:check": "node scripts/check-version.mjs",
    "sync": "node scripts/auto-commit.mjs",
    "icons:gen": "node scripts/gen-file-icons.mjs"
  },
  "build": {
    "appId": "com.orayyilmaz.novacode",
    "productName": "NovaCode Studio",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "electron-github.cjs",
      "electron-git.cjs",
      "electron-secrets.cjs",
      "electron-ai.cjs",
      "electron-search.cjs",
      "electron-ext.cjs",
      "electron-update.cjs",
      "electron-analytics.cjs",
      "electron-term.cjs",
      "electron-debug.cjs",
      "electron-pty.cjs",
      "electron-lsp.cjs",
      "electron-textbuffer.cjs",
      "electron-paths.cjs",
      "electron-preview.cjs",
      "electron-gitignore.cjs",
      "electron-history.cjs",
      "electron-snippets.cjs",
      "electron-trust.cjs",
      "electron-ssh.cjs",
      "electron-ssh-core.cjs",
      "package.json",
      "!**/node_modules/{cpu-features,nan}/**"
    ],
    "electronFuses": {
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "NovaCode-Studio-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Development",
      "synopsis": "NovaCode Studio",
      "maintainer": "Oray Yılmaz <orayyilmaz16@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NovaCode-Studio-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaCode Studio",
      "runAfterFinish": true,
      "artifactName": "NovaCode-Studio-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@lydell/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "orayyilmaz16",
        "repo": "NovaCode-Studio"
      }
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrent": "^0.3.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "6.8.11",
    "lib0": "0.2.120",
    "lucide-react": "^1.82.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.5",
    "ws": "8.23.0",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    },
    "minimatch@^9": "11.0.1",
    "minimatch@^10": "11.0.1"
  }
}
