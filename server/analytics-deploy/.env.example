# install.sh bu dosyayı kendisi üretir. Elle kurarsan: cp .env.example .env && chmod 600 .env
# Token (istatistikleri okumak için): openssl rand -hex 32   (sohbete/commit'e yazma)
ANALYTICS_TOKEN=<TOKEN>
# Alan adın (DNS A kaydı bu sunucuya gitmeli). Alan adı yoksa <ip-tireli>.sslip.io; bu adres IP'ni açık eder, kalıcı için alan adı önerilir.
ANALYTICS_HOST=<ALAN_ADI>
