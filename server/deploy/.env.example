# install.sh bu dosyayı kendisi üretir. Elle kurarsan: cp .env.example .env && chmod 600 .env
# Token: openssl rand -hex 32   (en az 32 karakter; sohbete/commit'e yazma)
NOVA_SYNC_TOKEN=<TOKEN>
# Alan adın varsa onu yaz (DNS A kaydı bu sunucuya gitmeli). Yoksa: <ip-tireli>.sslip.io, örn. 203-0-113-10.sslip.io
SYNC_HOST=<ALAN_ADI_VEYA_IP-TIRELI.sslip.io>
